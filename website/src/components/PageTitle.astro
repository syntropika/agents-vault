---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
const id = Astro.locals.starlightRoute.id;
const slug = id === 'docs' ? 'index' : id.split('/').at(-1);
const markdown = `/docs/${slug}.md`;
---
<DefaultPageTitle><slot /></DefaultPageTitle>
<div class="page-tools">
  <span class="boundary-label">Synthetic broker proxy</span>
  <a href={markdown}>Read Markdown</a>
  <button type="button" data-copy-page={markdown}>Copy page</button>
  <span role="status" aria-live="polite"></span>
</div>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-page]')) {
    button.addEventListener('click', async () => {
      const status = button.parentElement?.querySelector<HTMLElement>('[role="status"]');
      button.disabled = true;
      try {
        const response = await fetch(button.dataset.copyPage!);
        if (!response.ok) throw new Error('Page unavailable');
        await navigator.clipboard.writeText(await response.text());
        if (status) status.textContent = 'Page copied.';
      } catch {
        if (status) status.textContent = 'Could not copy. Open Read Markdown instead.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
