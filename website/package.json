{
  "name": "@agents-vault/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "predev": "npm run prepare:content",
    "dev": "astro dev --host 127.0.0.1",
    "precheck": "npm run prepare:content",
    "check": "astro check",
    "prebuild": "npm run prepare:content",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "verify": "npm run check && npm run build && node scripts/verify-output.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.5",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
