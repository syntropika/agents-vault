    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled action for adding credentials or confirming an operation.",
      "html": "<button class=\"ds-primary\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Add credential</button>",
      "css": ".ds-primary{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:999px;padding:8px 16px;min-height:36px;font-size:13px;font-weight:550;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background 160ms ease-out;background:var(--primary,#ececec);color:var(--primary-ink,#212121)}.ds-primary:hover:not(:disabled){opacity:.9}.ds-primary:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}.ds-primary:active:not(:disabled){transform:scale(.98)}.ds-primary:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}.ds-primary:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered action for supporting settings and decisions.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Rotate credential</button>",
      "css": ".ds-secondary{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid transparent;border-radius:999px;padding:8px 16px;min-height:36px;font-size:13px;font-weight:550;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background 160ms ease-out;background:transparent;color:var(--text,#ececec);border-color:var(--border,#404040)}.ds-secondary:hover:not(:disabled){background:var(--hover,#2f2f2f)}.ds-secondary:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}.ds-secondary:active:not(:disabled){transform:scale(.98)}.ds-secondary:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}.ds-secondary:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Underlined secondary action for cancelling an inline editor.",
      "html": "<button class=\"ds-text\" type=\"button\">Cancel</button>",
      "css": ".ds-text{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);border:0;background:transparent;color:var(--muted,#b5b5b5);padding:6px 3px;font-size:12px;line-height:1.5;text-decoration:underline;text-underline-offset:4px;cursor:pointer}.ds-text:hover:not(:disabled){color:var(--text,#ececec)}.ds-text:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}.ds-text:active:not(:disabled){transform:scale(.98)}.ds-text:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}.ds-text:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact header icon action with an accessible label and close keyboard-focus outline.",
      "html": "<button class=\"ds-icon\" type=\"button\" aria-label=\"Switch to light mode\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42\"/></svg></button>",
      "css": ".ds-icon{display:inline-grid;place-items:center;width:32px;height:32px;border:0;background:transparent;color:var(--muted,#b5b5b5);border-radius:50%;cursor:pointer}.ds-icon:hover:not(:disabled){background:var(--hover,#2f2f2f);color:var(--text,#ececec)}.ds-icon:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:2px;}.ds-icon:active:not(:disabled){transform:scale(.98)}.ds-icon:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-icon{transition:none}.ds-icon:active:not(:disabled){transform:none}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Rounded single-line field with shared keyboard focus treatment.",
      "html": "<label class=\"ds-label\" for=\"ds-host\">Host</label><input class=\"ds-field\" id=\"ds-host\" placeholder=\"api.example.com\"/>",
      "css": ".ds-label{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:block;margin-bottom:9px;font-size:12px;font-weight:550;line-height:1.5;color:var(--text,#ececec)}.ds-field{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;line-height:1.5;background:var(--surface,#212121);border:1px solid var(--border,#404040);border-radius:12px;padding:10px 12px;color:var(--text,#ececec);caret-color:var(--text,#ececec);width:100%}.ds-field::placeholder{color:var(--muted,#b5b5b5);opacity:1}.ds-field:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}"
    },
    {
      "name": "Segmented Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Pill navigation with distinct current, hover, and inset keyboard-focus feedback.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button class=\"ds-tab\" type=\"button\" aria-current=\"page\">Credentials</button><button class=\"ds-tab\" type=\"button\">Permissions</button><button class=\"ds-tab\" type=\"button\">Approvals</button><button class=\"ds-tab\" type=\"button\">Settings</button></nav>",
      "css": ".ds-nav{display:flex;gap:3px;border-radius:999px;background:var(--subtle,#2f2f2f);padding:4px}.ds-tab{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;align-items:center;gap:7px;border:0;padding:8px 16px;border-radius:999px;background:transparent;color:var(--muted,#b5b5b5);font-size:13px;font-weight:550;line-height:1.5;cursor:pointer;transition:background 160ms ease-out,color 160ms ease-out}.ds-tab[aria-current=\"page\"]{background:var(--bg,#171717);color:var(--text,#ececec)}.ds-tab:hover:not(:disabled){background:var(--surface,#212121);color:var(--text,#ececec)}.ds-tab[aria-current=\"page\"]:hover:not(:disabled){background:var(--bg,#171717)}.ds-tab:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:-2px;}.ds-tab:active:not(:disabled){transform:scale(.98)}.ds-tab:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}.ds-tab:active:not(:disabled){transform:none}}@media(max-width:640px){.ds-nav{width:100%;justify-content:space-between}.ds-tab{padding:8px 10px;font-size:11px}}:host-context([data-theme=\"light\"]) .ds-tab[aria-current=\"page\"],:host-context([data-theme=\"light\"]) .ds-tab[aria-current=\"page\"]:hover:not(:disabled){background:var(--surface,#fff)}:host-context([data-theme=\"light\"]) .ds-tab:hover:not([aria-current=\"page\"]){background:var(--hover,#e7e7eb)}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Passive compact status and count metadata.",
      "html": "<span class=\"ds-badge\">Active</span>",
      "css": ".ds-badge{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-block;color:var(--muted,#b5b5b5);background:var(--subtle,#2f2f2f);padding:3px 8px;border-radius:8px;font-size:11px;font-weight:500;line-height:1.5}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "Bordered label/value rows for credential configuration.",
      "html": "<section class=\"ds-group\"><div class=\"ds-setting\"><span class=\"ds-setting-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/><circle cx=\"12\" cy=\"16\" r=\"1\"/></svg></span><div class=\"ds-setting-label\"><strong>Approval</strong><span>Review each task before use.</span></div><div class=\"ds-setting-value\">Every run</div></div></section>",
      "css": ".ds-group{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);border:1px solid var(--border,#404040);border-radius:18px;overflow:clip;background:var(--panel,#212121);color:var(--text,#ececec)}.ds-setting{display:flex;gap:14px;align-items:center;padding:19px 20px;border-bottom:1px solid var(--border,#404040)}.ds-setting:last-child{border-bottom:0}.ds-setting-icon{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;background:var(--subtle,#2f2f2f);color:var(--muted,#b5b5b5)}.ds-setting-label{display:grid;gap:3px;flex:1;min-width:0;line-height:1.5}.ds-setting-label strong{font-size:13px;font-weight:550}.ds-setting-label span{font-size:11px;color:var(--muted,#b5b5b5)}.ds-setting-value{font-size:12px;color:var(--muted,#b5b5b5);max-width:44%;text-align:right;overflow-wrap:anywhere}@media(max-width:1100px){.ds-setting{flex-wrap:wrap;padding:16px}.ds-setting-value{padding-left:48px;max-width:100%;flex-basis:100%;text-align:left}}@media(max-width:640px){.ds-setting{gap:10px}.ds-setting-value{padding-left:44px}}"
    },
    {
      "name": "Selected Credential Row",
      "kind": "custom",
      "refersTo": "credential-row-selected",
      "description": "Icon, identifier, and host with a tonal selected state.",
      "html": "<button class=\"ds-record\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-record-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/><circle cx=\"12\" cy=\"16\" r=\"1\"/></svg></span><span class=\"ds-record-label\"><strong>Service credential</strong><span>api.example.com</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-record{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;align-items:center;gap:11px;width:100%;background:transparent;color:var(--text,#ececec);border:0;border-radius:14px;padding:12px 9px;text-align:left;cursor:pointer}.ds-record[aria-pressed=\"true\"]{background:var(--hover,#2f2f2f)}.ds-record-icon{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;background:var(--subtle,#2f2f2f);color:var(--muted,#b5b5b5)}.ds-record-label{display:grid;flex:1;min-width:0;gap:3px;line-height:1.5}.ds-record-label strong{font-size:13px;font-weight:550;overflow-wrap:anywhere}.ds-record-label>span{font-size:11px;color:var(--muted,#b5b5b5);overflow-wrap:anywhere}.ds-record>svg{color:var(--muted,#b5b5b5)}.ds-record:hover:not(:disabled){background:var(--hover,#2f2f2f)}.ds-record:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}.ds-record:active:not(:disabled){transform:scale(.98)}.ds-record:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-record{transition:none}.ds-record:active:not(:disabled){transform:none}}:host-context([data-theme=\"light\"]) .ds-record-icon{background:var(--panel,#fafafa)}"
    }
  ],
  "narrative": {
    "northStar": "Focused settings",
    "overview": "Agents Vault uses a quiet, compact settings language for local credential administration. Neutral surfaces and clear label/value relationships carry the interface. Rounded controls, restrained system typography, and immediate state feedback express the user-approved Apple and shadcn/HeroUI direction.\n\nDark is the initial appearance, using three principal near-black surface tones. The main canvas uses the darkest tone, grouped panels use the middle tone, and compact details and selection states use the lightest tone. Pure black is excluded from these surfaces by the user-approved palette refinement. An optional light palette uses the same semantic roles. The interface is semantic UI with vector icons; it does not depend on photography or shipping raster artwork. The system below is extracted from `web/src/styles.css` and the components in `web/src/App.tsx`.",
    "keyCharacteristics": [
      "Three near-black surface tones in dark mode, with neutral text and a separate light appearance.",
      "Compact pill actions and gently rounded grouped settings.",
      "Flat surfaces separated by tone and thin borders.",
      "Functional system type with explicit heading and control hierarchy.",
      "Brief state transitions with static feedback under reduced motion."
    ],
    "rules": [
      {
        "name": "The Neutral Roles Rule",
        "body": "Apply the same semantic color roles in both themes; appearance changes their values, not the information hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Darkest Canvas Rule",
        "body": "Keep the dark main canvas at the background tone; panels and compact details step lighter above it.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal layering and borders for the existing settings materials; preserve their flat resting appearance.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic neutral roles consistently across dark and light appearances.",
      "Do keep the dark main canvas at the darkest background tone.",
      "Do preserve compact pill actions, rounded fields, and flat bordered groups.",
      "Do keep supporting metadata muted while headings, values, and focus use the text role.",
      "Do provide visible keyboard focus and retain static state feedback under reduced motion.",
      "Do allow long identifiers, hosts, and command previews to wrap."
    ],
    "donts": [
      "Don't introduce teal or blue accent styling into this approved neutral world.",
      "Don't use pure black for dark surfaces; preserve the three near-black surface tones.",
      "Don't replace the user-selected system typography with a decorative display face.",
      "Don't rely on shadows or raster artwork to explain the existing settings hierarchy.",
      "Don't turn passive badges into controls without explicit interactive semantics."
    ]
  }
