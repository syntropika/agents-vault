      "css": ".ds-label{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:block;margin-bottom:9px;font-size:12px;font-weight:550;line-height:1.5;color:var(--text,#ececec)}.ds-field{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);font-size:14px;line-height:1.5;background:var(--surface,#212121);border:1px solid var(--border,#404040);border-radius:12px;padding:10px 12px;color:var(--text,#ececec);caret-color:var(--text,#ececec);width:100%}.ds-field::placeholder{color:var(--muted,#b5b5b5);opacity:1}.ds-field:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}"
    },
    {
      "name": "Segmented Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Pill navigation with distinct current, hover, and inset keyboard-focus feedback.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button class=\"ds-tab\" type=\"button\" aria-current=\"page\">Credentials</button><button class=\"ds-tab\" type=\"button\">Permissions</button><button class=\"ds-tab\" type=\"button\">Approvals</button><button class=\"ds-tab\" type=\"button\">Actions</button><button class=\"ds-tab\" type=\"button\">Settings</button></nav>",
      "css": ".ds-nav{display:flex;gap:3px;border-radius:999px;background:var(--subtle,#2f2f2f);padding:4px}.ds-tab{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;align-items:center;gap:7px;border:0;padding:8px 16px;border-radius:999px;background:transparent;color:var(--muted,#b5b5b5);font-size:13px;font-weight:550;line-height:1.5;cursor:pointer;transition:background 160ms ease-out,color 160ms ease-out}.ds-tab[aria-current=\"page\"]{background:var(--bg,#171717);color:var(--text,#ececec)}.ds-tab:hover:not(:disabled){background:var(--surface,#212121);color:var(--text,#ececec)}.ds-tab[aria-current=\"page\"]:hover:not(:disabled){background:var(--bg,#171717)}.ds-tab:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:-2px;}.ds-tab:active:not(:disabled){transform:scale(.98)}.ds-tab:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}.ds-tab:active:not(:disabled){transform:none}}@media(max-width:640px){.ds-nav{width:100%;justify-content:space-between}.ds-tab{padding:8px 10px;font-size:11px}}:host-context([data-theme=\"light\"]) .ds-tab[aria-current=\"page\"],:host-context([data-theme=\"light\"]) .ds-tab[aria-current=\"page\"]:hover:not(:disabled){background:var(--surface,#fff)}:host-context([data-theme=\"light\"]) .ds-tab:hover:not([aria-current=\"page\"]){background:var(--hover,#e7e7eb)}@media(max-width:600px){.ds-nav{flex-wrap:wrap;justify-content:center;border-radius:18px;gap:2px}.ds-tab{padding-inline:8px;font-size:12px}}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Passive compact status and count metadata.",
      "html": "<span class=\"ds-badge\">Active</span>",
      "css": ".ds-badge{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:inline-block;color:var(--muted,#b5b5b5);background:var(--subtle,#2f2f2f);padding:3px 8px;border-radius:8px;font-size:11px;font-weight:500;line-height:1.5}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "Bordered label/value rows for credential configuration.",
      "html": "<section class=\"ds-group\"><div class=\"ds-setting\"><span class=\"ds-setting-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/><circle cx=\"12\" cy=\"16\" r=\"1\"/></svg></span><div class=\"ds-setting-label\"><strong>Approval</strong><span>Review each action before use.</span></div><div class=\"ds-setting-value\">Every run</div></div></section>",
      "css": ".ds-group{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);border:1px solid var(--border,#404040);border-radius:18px;overflow:clip;background:var(--panel,#212121);color:var(--text,#ececec)}.ds-setting{display:flex;gap:14px;align-items:center;padding:19px 20px;border-bottom:1px solid var(--border,#404040)}.ds-setting:last-child{border-bottom:0}.ds-setting-icon{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;background:var(--subtle,#2f2f2f);color:var(--muted,#b5b5b5)}.ds-setting-label{display:grid;gap:3px;flex:1;min-width:0;line-height:1.5}.ds-setting-label strong{font-size:13px;font-weight:550}.ds-setting-label span{font-size:11px;color:var(--muted,#b5b5b5)}.ds-setting-value{font-size:12px;color:var(--muted,#b5b5b5);max-width:44%;text-align:right;overflow-wrap:anywhere}@media(max-width:1100px){.ds-setting{flex-wrap:wrap;padding:16px}.ds-setting-value{padding-left:48px;max-width:100%;flex-basis:100%;text-align:left}}@media(max-width:640px){.ds-setting{gap:10px}.ds-setting-value{padding-left:44px}}"
    },
    {
      "name": "Selected Credential Row",
      "kind": "custom",
      "refersTo": "credential-row-selected",
      "description": "Icon, identifier, and host with a tonal selected state.",
      "html": "<button class=\"ds-record\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-record-icon\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"/><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"/><circle cx=\"12\" cy=\"16\" r=\"1\"/></svg></span><span class=\"ds-record-label\"><strong>Service credential</strong><span>api.example.com</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></button>",
      "css": ".ds-record{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);display:flex;align-items:center;gap:11px;width:100%;background:transparent;color:var(--text,#ececec);border:0;border-radius:14px;padding:12px 9px;text-align:left;cursor:pointer}.ds-record[aria-pressed=\"true\"]{background:var(--hover,#2f2f2f)}.ds-record-icon{display:grid;place-items:center;flex:none;width:34px;height:34px;border-radius:12px;background:var(--subtle,#2f2f2f);color:var(--muted,#b5b5b5)}.ds-record-label{display:grid;flex:1;min-width:0;gap:3px;line-height:1.5}.ds-record-label strong{font-size:13px;font-weight:550;overflow-wrap:anywhere}.ds-record-label>span{font-size:11px;color:var(--muted,#b5b5b5);overflow-wrap:anywhere}.ds-record>svg{color:var(--muted,#b5b5b5)}.ds-record:hover:not(:disabled){background:var(--hover,#2f2f2f)}.ds-record:focus-visible{outline:2px solid var(--text,#ececec);outline-offset:4px;}.ds-record:active:not(:disabled){transform:scale(.98)}.ds-record:disabled{cursor:not-allowed;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-record{transition:none}.ds-record:active:not(:disabled){transform:none}}:host-context([data-theme=\"light\"]) .ds-record-icon{background:var(--panel,#fafafa)}"
    },
    {
      "name": "Public Primary Action",
      "kind": "button",
      "refersTo": "website-button-primary",
      "description": "Compact pale pill action for the public CLI quickstart.",
      "html": "<a class=\"ds-website-primary\" href=\"/docs/quickstart/\">Start with the CLI <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-website-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:44px;padding:10px 20px;border:1px solid var(--accent,#ececec);border-radius:999px;background:var(--accent,#ececec);color:var(--accent-ink,#171717);font:600 14px \"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;text-decoration:none}.ds-website-primary:hover{background:var(--accent-hover,#ffffff);border-color:var(--accent-hover,#ffffff)}.ds-website-primary:focus-visible{outline:2px solid var(--accent,#ececec);outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-website-primary{transition:background-color 160ms ease-out,border-color 160ms ease-out}}@media(max-width:500px){.ds-website-primary{min-height:44px;padding:10px 16px;font-size:13px;gap:12px}}.ds-website-primary{min-width:201px}@media(max-width:1280px){.ds-website-primary{min-width:0}}"
    },
    {
      "name": "Public Secondary Action",
      "kind": "button",
      "refersTo": "website-button-secondary",
      "description": "Bordered public reading action with neutral hover feedback.",
      "html": "<a class=\"ds-website-secondary\" href=\"/docs/\">Read the docs</a>",
      "css": ".ds-website-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 20px;border:1px solid var(--border,#404040);border-radius:999px;background:transparent;color:var(--text,#ececec);font:400 14px \"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;text-decoration:none}.ds-website-secondary:hover{background:var(--subtle,#2f2f2f)}.ds-website-secondary:focus-visible{outline:2px solid var(--accent,#ececec);outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-website-secondary{transition:background-color 160ms ease-out}}@media(max-width:500px){.ds-website-secondary{min-height:44px;padding:10px 16px;font-size:13px}}.ds-website-secondary{min-width:152px}@media(max-width:1280px){.ds-website-secondary{min-width:0}}"
    },
    {
      "name": "Public Example Selector",
      "kind": "custom",
      "refersTo": "website-environment-picker",
      "description": "Illustrative environment selection; shipping behavior updates the public value and status without resolving credentials.",
      "html": "<fieldset class=\"ds-website-picker\"><legend>Example environment</legend><button type=\"button\" aria-pressed=\"true\">Development</button><button type=\"button\" aria-pressed=\"false\">Production</button></fieldset>",
      "css": ".ds-website-picker{display:flex;gap:3px;border:0;padding:3px;border-radius:999px;background:var(--subtle,#2f2f2f);margin:0;width:fit-content}.ds-website-picker legend{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.ds-website-picker button{border:0;background:transparent;padding:8px 11px;border-radius:999px;color:var(--muted,#b5b5b5);font:400 11px \"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;cursor:pointer}.ds-website-picker button[aria-pressed=\"true\"]{background:var(--accent-surface,#2f2f2f);color:var(--accent,#ececec)}.ds-website-picker button:hover{color:var(--text,#ececec)}.ds-website-picker button:focus-visible{outline:2px solid var(--accent,#ececec);outline-offset:-2px}@media(prefers-reduced-motion:no-preference){.ds-website-picker button{transition:background-color 160ms ease-out,color 160ms ease-out}}"
    },
    {
      "name": "Public Configuration Window",
      "kind": "card",
      "refersTo": "website-window",
      "description": "Flat rounded placeholder output material with Geist prose and Geist Mono configuration.",
      "html": "<section class=\"ds-website-window\" aria-label=\"Illustrative project configuration\"><header>av.toml <span>Project configuration</span></header><pre><code>schema = 2\n\n[values.SERVICE_TOKEN]\ntype = \"string\"\nsecret = \"secret://example/token\"</code></pre><p>Illustrative project configuration</p></section>",
      "css": ".ds-website-window{border:1px solid var(--border,#404040);border-radius:16px;overflow:hidden;background:var(--surface,#212121);color:var(--text,#ececec);font-family:\"Geist\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-website-window header{display:flex;justify-content:space-between;gap:16px;padding:16px 18px;border-bottom:1px solid var(--border,#404040);font-size:13px;font-weight:550}.ds-website-window header{font-family:\"Geist Mono\",ui-monospace,monospace}.ds-website-window header span{font-family:\"Geist\",sans-serif;color:var(--muted,#b5b5b5);font-size:12px;font-weight:400}.ds-website-window pre{padding:20px 22px;margin:0;overflow:auto;line-height:25px;font-size:14px}.ds-website-window code{font-family:\"Geist Mono\",ui-monospace,SFMono-Regular,Consolas,monospace}.ds-website-window p{padding:16px 24px;margin:0;border-top:1px solid var(--border,#404040);color:var(--muted,#b5b5b5);font-size:12px}"
    },
    {
      "name": "Public Brand Tile",
      "kind": "custom",
      "refersTo": "website-brand-mark",
      "description": "Canonical neutral tile with the aligned two-piece A/V, shared by documentation and the generated favicon.",
      "html": "<svg class=\"ds-website-logo\" role=\"img\" aria-label=\"Agents Vault\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 128 128\"><rect width=\"128\" height=\"128\" rx=\"34\" fill=\"#ececec\"/><g transform=\"translate(25 22) scale(.88)\"><g fill=\"#171717\"><path fill-rule=\"evenodd\" d=\"M1.807 36.636 L33.807 2.35A3 3 0 0 1 38.193 2.35L68.838 35.183A3 3 0 0 1 68.838 39.277L48.748 60.802A3 3 0 0 1 44.181 60.589L36.901 51.166A3 3 0 0 0 34.527 50L20 50A3 3 0 0 0 17 53L17 69A3 3 0 0 1 14 72L4 72A3 3 0 0 1 1 69L1 38.682A3 3 0 0 1 1.807 36.636Z M26.302 32.991 L35.561 23.07A0.6 0.6 0 0 1 36.439 23.07L45.698 32.991A0.6 0.6 0 0 1 45.259 34L26.741 34A0.6 0.6 0 0 1 26.302 32.991Z\" transform=\"translate(0 0)\"/><path d=\"M22 53H33Q35 53 37 56L45 66Q46 68 48 66L76 36Q79 33 82 34Q86 35 86 40V48Q86 51 83 54L51.266666666666666 88Q46.63333333333333 94 42 88L22 62Q20 59 20 56Q20 53 22 53Z\" transform=\"translate(0 0)\"/></g></g></svg>",
      "css": ".ds-website-logo{display:block;width:34px;height:34px;flex:none}"
    },
    {
      "name": "Public Brand Symbol",
      "kind": "custom",
      "refersTo": "website-brand-symbol",
      "description": "Standalone pale glyph with aligned A/V diagonals, used in the public header and broker node.",
      "html": "<svg class=\"ds-website-symbol\" role=\"img\" aria-label=\"Agents Vault\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"-8 -8 112 112\"><g fill=\"#ececec\"><path fill-rule=\"evenodd\" d=\"M1.807 36.636 L33.807 2.35A3 3 0 0 1 38.193 2.35L68.838 35.183A3 3 0 0 1 68.838 39.277L48.748 60.802A3 3 0 0 1 44.181 60.589L36.901 51.166A3 3 0 0 0 34.527 50L20 50A3 3 0 0 0 17 53L17 69A3 3 0 0 1 14 72L4 72A3 3 0 0 1 1 69L1 38.682A3 3 0 0 1 1.807 36.636Z M26.302 32.991 L35.561 23.07A0.6 0.6 0 0 1 36.439 23.07L45.698 32.991A0.6 0.6 0 0 1 45.259 34L26.741 34A0.6 0.6 0 0 1 26.302 32.991Z\" transform=\"translate(0 0)\"/><path d=\"M22 53H33Q35 53 37 56L45 66Q46 68 48 66L76 36Q79 33 82 34Q86 35 86 40V48Q86 51 83 54L51.266666666666666 88Q46.63333333333333 94 42 88L22 62Q20 59 20 56Q20 53 22 53Z\" transform=\"translate(0 0)\"/></g></svg>",
      "css": ".ds-website-symbol{display:block;width:34px;height:34px;flex:none}@media(max-width:500px){.ds-website-symbol{width:28px;height:28px}}"
    }
  ],
  "narrative": {
    "northStar": "Focused settings",
    "overview": "Agents Vault uses a quiet, compact settings language for local credential administration. Neutral surfaces and clear label/value relationships carry the interface. Rounded controls, restrained system typography, and immediate state feedback express the user-approved Apple and shadcn/HeroUI direction.\n\nDark is the initial appearance, using three principal near-black surface tones. The main canvas uses the darkest tone, grouped panels use the middle tone, and compact details and selection states use the lightest tone. Pure black is excluded from these surfaces by the user-approved palette refinement. An optional light palette uses the same semantic roles. The operator interface is semantic UI with vector icons; it does not depend on photography or shipping raster artwork. The operator guidance is extracted from `web/src/styles.css` and the components in `web/src/App.tsx`.\n\nThe public website applies the same rounded Apple and shadcn direction at a more spacious reading scale. Its named direction is **Readable projects with deliberate access**: monochrome windows, readable configuration, compact actions, and pale emphasis for connection feedback. Self-hosted Geist sans and Geist Mono add precise typographic hierarchy, while structural rails and section dividers organize the public canvas. Website tokens are scoped with `website-`; the console retains its neutral primary actions. Public runtime sources are `website/src/styles/landing.css`, `website/src/styles/docs.css`, and the Astro scene components. The registered [public surface brief](.impeccable/surfaces/website-src-pages-index-astro.md) owns the landing composition and reading sequence.",
    "keyCharacteristics": [
      "Three near-black surface tones in dark mode, with neutral text and a separate light appearance.",
      "Compact pill actions and gently rounded grouped settings.",
      "Flat surfaces separated by tone and thin borders.",
      "Functional system type with explicit heading and control hierarchy.",
      "Brief state transitions with static feedback under reduced motion.",
      "Public pages use Geist headings and prose, Geist Mono configuration, structural rails, flat rounded windows, and monochrome action and trace feedback."
    ],
    "rules": [
      {
        "name": "The Neutral Roles Rule",
        "body": "Apply the same semantic color roles in both themes; appearance changes their values, not the information hierarchy.",
        "section": "colors"
      },
      {
        "name": "The Darkest Canvas Rule",
        "body": "Keep the dark main canvas at the background tone; panels and compact details step lighter above it.",
        "section": "colors"
      },
      {
        "name": "The Public Emphasis Rule",
        "body": "Use the website emphasis roles for actions, focus, selection, and delivery feedback; retain neutral surfaces and the operator console's existing primary roles.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal layering and borders for the existing settings materials; preserve their flat resting appearance.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic neutral roles consistently across dark and light appearances.",
      "Do keep the dark main canvas at the darkest background tone.",
      "Do preserve compact pill actions, rounded fields, and flat bordered groups.",
      "Do keep supporting metadata muted while headings, values, and focus use the text role.",
      "Do provide visible keyboard focus and retain static state feedback under reduced motion.",
      "Do allow long identifiers, hosts, and command previews to wrap.",
      "Do use the public monochrome emphasis roles and Geist typography consistently with flat neutral window materials.",
      "Do reuse the canonical public tile or standalone glyph and preserve the two-piece geometry.",
      "Do align structural rails and section dividers with the public reading grid and keep reference details in separated rows.",
      "Do retain readable static scenes, visible keyboard focus, and the local-only placeholder behavior."
    ],
    "donts": [
      "Don't introduce teal or blue accent styling into the operator console's approved neutral world.",
      "Don't use pure black for dark surfaces; preserve the three near-black surface tones.",
      "Don't replace the operator console's user-selected system typography with a decorative display face.",
      "Don't rely on shadows or raster artwork to explain the existing settings hierarchy.",
      "Don't turn passive badges into controls without explicit interactive semantics.",
      "Don't use maturity labels in public copy; state the actual delivery, custody, and platform limits.",
      "Don't treat illustrative configuration or diagrams as live vault access or evidence of production custody."
    ]
  }
}
